def make_ruler(n):
    a = 0
    line = ''
    bottom_line = ''

    while a <= n:
        if a < n:
            line += '|....'
            bottom_line += str(a) + ' ' * (5 - len(str(a)))
            a += 1
        elif a == n:
            line += '|'
            bottom_line += str(a)
            a += 1

    return(line + '\n' + bottom_line)

def make_grid(rows, cols):
    line=''
    bot_line=''
    a=0
    while a<=cols:
        if a<cols:
            line+='+---'
            bot_line+='|   '
            a+=1
        if a==cols:
            line+='+'
            bot_line+='|'
            a+=1
    i=0
    result=''
    while i <= rows:
        if i<rows:
            result+=(line)+'\n'
            result+=(bot_line)+'\n'
            i+=1
        if i==rows:
            result+=(line)
            i+=1

    return result

print(make_ruler(20))
print(make_grid(15, 5))